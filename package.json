{
  "name": "pk-stuff",
  "version": "1.1.0",
  "displayName": "PK Stuff",
  "description": "Themes, snippets and keybindings for VSCode",
  "license": "MIT",
  "author": "Peter Kin",
  "publisher": "KinPeter",
  "repository": {
    "type": "git",
    "url": "https://github.com/KinPeter/my-vs-code.git"
  },
  "scripts": {
    "build": "vsce package"
  },
  "devDependencies": {
    "vsce": "^2.15.0"
  },
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Themes",
    "Snippets",
    "Keymaps"
  ],
  "icon": "icon.png",
  "contributes": {
    "themes": [
      {
        "label": "PK Dracula IntelliJ",
        "uiTheme": "vs-dark",
        "path": "./themes/pk-dracula-intellij.json"
      },
      {
        "label": "PK Dracula Modern",
        "uiTheme": "vs-dark",
        "path": "./themes/pk-dracula-modern.json"
      }
    ],
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/pk-snippets.code-snippets"
      }
    ],
    "configurationDefaults": {
      "editor.wordWrap": "on",
      "editor.renderWhitespace": "none",
      "editor.suggestSelection": "first",
      "editor.fontFamily": "'Source Code Pro', Consolas, 'Courier New', monospace",
      "editor.minimap.renderCharacters": false,
      "editor.bracketPairColorization.enabled": false,
      "workbench.editor.pinnedTabsOnSeparateRow": true,
      "workbench.tree.indent": 15,
      "workbench.statusBar.visible": true,
      "workbench.editor.wrapTabs": true,
      "explorer.compactFolders": false,
      "explorer.confirmDelete": false,
      "breadcrumbs.enabled": false,
      "js/ts.implicitProjectConfig.experimentalDecorators": true,
      "javascript.updateImportsOnFileMove.enabled": "always",
      "emmet.includeLanguages": {
        "javascript": "javascriptreact",
        "typescript": "typescriptreact"
      },
      "git.autofetch": true,
      "git.confirmSync": false,
      "git.blame.editorDecoration.enabled": false,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "prettier.documentSelectors": [
        "**/*.{js,jsx,ts,tsx,css,scss,sass,html,json,md,toml,yaml,yml}"
      ],
      "editor.formatOnPaste": true,
      "editor.formatOnSave": true,
      "editor.tabSize": 2,
      "python.analysis.typeCheckingMode": "standard",
      "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.tabSize": 4
      }
    },
    "keybindings": [
      {
        "key": "ctrl+s",
        "mac": "cmd+s",
        "command": "workbench.action.files.saveAll"
      },
      {
        "key": "shift shift",
        "mac": "shift shift",
        "command": "workbench.action.quickOpen",
        "intellij": "Search everywhere"
      },
      {
        "key": "ctrl ctrl",
        "mac": "ctrl ctrl",
        "command": "workbench.action.showCommands",
        "intellij": "Find Action"
      },
      {
        "key": "ctrl+d",
        "mac": "cmd+d",
        "command": "editor.action.copyLinesDownAction",
        "when": "editorTextFocus && !editorReadonly && !editorHasSelection",
        "intellij": "Duplicate Line"
      },
      {
        "key": "ctrl+d",
        "mac": "cmd+d",
        "command": "editor.action.duplicateSelection",
        "when": "editorTextFocus && !editorReadonly && editorHasSelection",
        "intellij": "Duplicate Selection"
      }
    ]
  }
}
